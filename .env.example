# Required by scripts/generator.py and the Daily System Design Post workflow.
XAI_API_KEY=replace-with-your-xai-api-key

# Optional. Defaults to the Grok model used by this repository.
XAI_MODEL=grok-4.7

# Optional. xAI's OpenAI-compatible API endpoint.
XAI_BASE_URL=https://api.x.ai/v1

# Optional. Maximum retry count for transient xAI API errors.
XAI_MAX_RETRIES=3
