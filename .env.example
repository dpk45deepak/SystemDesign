# Copy this file to .env and fill in your own values.
# NEVER commit your real .env file to source control.

# Google Gemini API key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model to use for generation
GEMINI_MODEL=gemini-2.5-flash

# Comma-separated fallback models used when the primary model is temporarily unavailable
GEMINI_FALLBACK_MODELS=gemini-2.5-flash-lite

# Retry settings for temporary Gemini API failures (429/5xx)
GEMINI_MAX_RETRIES=3
GEMINI_RETRY_DELAY_SECONDS=2

# Optional: override paths (defaults shown)
TOPICS_JSON_PATH=scripts/topics.json
TOPICS_OUTPUT_DIR=topics
README_PATH=README.md
