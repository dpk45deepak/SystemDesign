# Required by scripts/generator.py and the Daily System Design Post workflow.
GROQ_API_KEY=replace-with-your-xai-api-key

# Optional. Defaults to the Grok model used by this repository.
GROQ_MODEL=openai/gpt-oss-20b

# Optional. Groq's OpenAI-compatible API endpoint.

# Optional. Maximum retry count for transient Groq API errors.
GROQ_MAX_RETRIES=3
