# Required by scripts/generator.py and the Daily System Design Post workflow.
GEMINI_API_KEY=replace-with-your-gemini-api-key

# Optional. Use this to select another Gemini model available to your API key.
GEMINI_MODEL=gemini-2.5-flash

# Optional comma-separated models to try after GEMINI_MODEL for transient errors.
GEMINI_FALLBACK_MODELS=
